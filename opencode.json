{
  "$schema": "https://opencode.ai/config.json",
  "model": "chatjimmy/llama3.1-8B",
  "agents": {
    "build": {
      "model": "chatjimmy/llama3.1-8B"
    },
    "plan": {
      "model": "chatjimmy/llama3.1-8B"
    }
  },
  "providers": {
    "chatjimmy": {
      "name": "ChatJimmy",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://127.0.0.1:8383/v1"
      },
      "models": {
        "llama3.1-8B": {
          "name": "Llama 3.1 8B (ChatJimmy)",
          "limit": {
            "context": 6144,
            "input": 6000,
            "output": 2048
          }
        }
      }
    }
  }
}